# ── .dockerignore (root) ──────────────────────────────────────────────────────
# Applied to all docker build contexts rooted at the repository root.
# Per-Dockerfile overrides are in .dockerignore.api and .dockerignore.contracts.

# Secrets and environment files — NEVER bake these into images
.env
.env.*
!.env.example

# Git history — not needed in the image, reduces context size significantly
.git/
.gitignore

# CI/CD configuration
.github/

# Documentation
docs/
load-tests/results/

# OS artefacts
.DS_Store
Thumbs.db
*.swp
*.swo

# Log files
*.log
npm-debug.log*
yarn-debug.log*

# Node.js build artifacts
**/node_modules/
api/dist/
services/*/dist/

# Rust build artifacts — cargo-chef handles caching inside the image
target/
# Do NOT exclude Cargo.lock for reproducible builds

# Test outputs
coverage/
.nyc_output/

# Vault init secrets — must never enter any container
init.json
vault-init.json

# TLS / key material
*.pem
*.key
*.p12
*.pfx
*.crt
