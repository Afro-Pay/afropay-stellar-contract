# ============================================================
# Dockerfile.frontend — AfroPay Next.js Dashboard
# ============================================================
# NOTE: The Next.js frontend is planned (see docs/adr/ADR-008-nextjs-app-router.md)
# but the source code has not yet been scaffolded. This Dockerfile is
# written to the expected layout so it is ready to use the moment
# `frontend/` is added to the repository.
#
# Expected repository structure once frontend is added:
#   frontend/
#     package.json
#     package-lock.json
#     next.config.ts        # must set output: 'standalone'
#     tsconfig.json
#     app/                  # Next.js App Router
#     public/
#
# Multi-stage build:
#   deps     — install ALL node_modules
#   builder  — next build  (produces .next/standalone)
#   runner   — minimal image using standalone output
# ============================================================

# ── Stage 1: Dependencies ────────────────────────────────────────────────────
FROM node:22-alpine3.20 AS deps
WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# ── Stage 2: Build ───────────────────────────────────────────────────────────
FROM node:22-alpine3.20 AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ .

ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build

# ── Stage 3: Runtime ─────────────────────────────────────────────────────────
FROM node:22-alpine3.20 AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001 -G nodejs

# Next.js standalone output contains a self-contained server.js
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -qO- http://localhost:3000/api/health || exit 1

CMD ["node", "server.js"]
