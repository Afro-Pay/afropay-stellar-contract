{
  "name": "afropay-anchor-api",
  "version": "0.1.0",
  "private": true,
  "description": "AfroPay Stellar anchor API — SEP-1, SEP-10, SEP-12, SEP-31 compliant endpoints",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc && node dist/server.js",
    "test": "jest --runInBand"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.ts"],
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "strict": true,
          "esModuleInterop": true,
          "module": "commonjs",
          "target": "ES2022",
          "moduleResolution": "node",
          "resolveJsonModule": true,
          "skipLibCheck": true
        }
      }
    },
    "moduleNameMapper": {
      "^../../services/queue/dlq$": "<rootDir>/../services/queue/dlq.ts"
    }
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@stellar/stellar-sdk": "^12.3.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "@types/supertest": "6.0.2",
    "@types/uuid": "^9.0.8",
    "jest": "29.7.0",
    "supertest": "6.3.4",
    "ts-jest": "29.1.4",
    "typescript": "^5.4.0"
  }
}
