{
  "name": "afropay-anchor-api",
  "version": "0.1.0",
  "private": true,
  "description": "AfroPay Stellar anchor API — SEP-1, SEP-10, SEP-12, SEP-31 compliant endpoints",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc && node dist/server.js",
    "test": "jest --config jest.config.json --runInBand",
    "test:ci": "jest --config jest.config.json --runInBand --forceExit",
    "docs:serve": "npx @redocly/cli preview-docs api/openapi.yaml --port 8080",
    "docs:build": "npx @redocly/cli build-docs api/openapi.yaml --output docs-dist/index.html",
    "spec:validate": "openapi-spec-validator api/openapi.yaml",
    "schema:export": "node scripts/export-json-schemas.js"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@stellar/stellar-sdk": "^12.3.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "prom-client": "15.1.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "@types/supertest": "6.0.2",
    "@types/uuid": "^9.0.8",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
