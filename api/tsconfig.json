{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": [
    "server.ts",
    "app.ts",
    "config.ts",
    "store.ts",
    "routes/**/*.ts",
    "middleware/**/*.ts",
    "webhooks/**/*.ts",
    "services/**/*.ts",
    "__tests__/**/*.ts"
  ],
  "exclude": [
    "../services/**"
  ]
}
