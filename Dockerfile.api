# ============================================================
# Dockerfile.api — AfroPay Anchor API (Express / Node.js 22)
# ============================================================
# Multi-stage build:
#   deps     — install production node_modules only
#   builder  — compile TypeScript → dist/
#   runner   — minimal image with compiled output + prod deps
#
# Target image size: < 200 MB (verified with `docker image inspect`)
# ============================================================

# ── Stage 1: Install ALL dependencies (dev + prod) for compilation ──────────
FROM node:22-alpine3.20 AS deps
WORKDIR /app

# Install OS packages needed for native modules (pg uses node-gyp)
RUN apk add --no-cache python3 make g++ linux-headers

COPY api/package.json api/package-lock.json ./
RUN npm ci --ignore-scripts

# ── Stage 2: Compile TypeScript ──────────────────────────────────────────────
FROM node:22-alpine3.20 AS builder
WORKDIR /app

# Copy installed deps from previous stage
COPY --from=deps /app/node_modules ./node_modules

# Copy source
COPY api/tsconfig.json ./
COPY api/package.json api/package-lock.json ./
COPY api/server.ts api/app.ts api/config.ts api/store.ts ./
COPY api/routes/ ./routes/
COPY api/middleware/ ./middleware/
COPY api/webhooks/ ./webhooks/
COPY api/services/ ./services/

RUN npm run build

# ── Stage 3: Install ONLY production dependencies ───────────────────────────
FROM node:22-alpine3.20 AS prod-deps
WORKDIR /app

RUN apk add --no-cache python3 make g++ linux-headers

COPY api/package.json api/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

# ── Stage 4: Minimal runtime image ──────────────────────────────────────────
FROM node:22-alpine3.20 AS runner
WORKDIR /app

# Non-root user for security
RUN addgroup -g 1001 -S nodejs && adduser -S afropay -u 1001 -G nodejs

# Copy compiled output + production dependencies
COPY --from=builder --chown=afropay:nodejs /app/dist ./dist
COPY --from=prod-deps --chown=afropay:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=afropay:nodejs /app/package.json ./

# Copy stellar.toml so the API can serve SEP-1 in local dev.
# In production this is volume-mounted or served via CDN.
COPY --chown=afropay:nodejs public/ ./public/

USER afropay

EXPOSE 8000

ENV NODE_ENV=production

# Healthcheck — uses the /health endpoint added in app.ts
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -qO- http://localhost:8000/health || exit 1

CMD ["node", "dist/server.js"]
