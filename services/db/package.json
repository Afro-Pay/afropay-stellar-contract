{
  "name": "afropay-db",
  "version": "0.1.0",
  "private": true,
  "description": "Vault-backed dynamic Postgres credential manager for AfroPay",
  "scripts": {
    "test": "jest --runInBand --forceExit",
    "test:ci": "jest --runInBand --forceExit --ci"
  },
  "dependencies": {
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.ts"],
    "globals": {
      "ts-jest": {
        "tsconfig": "<rootDir>/tsconfig.json"
      }
    },
    "clearMocks": true,
    "testTimeout": 15000
  }
}
