{
  "name": "afropay-horizon-listener",
  "version": "0.1.0",
  "private": true,
  "description": "Stellar Horizon SSE listener with gap detection, catch-up replay, and idempotent event processing",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.3.0",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  }
}
