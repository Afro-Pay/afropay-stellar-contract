{
  "name": "afropay-relayer",
  "version": "0.1.0",
  "private": true,
  "description": "Stellar transaction relayer with atomic Redis-backed sequence-number reservation",
  "main": "dist/submit.js",
  "scripts": {
    "build": "tsc",
    "test": "jest --runInBand --forceExit",
    "test:ci": "jest --runInBand --forceExit --ci"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.3.0",
    "ioredis": "^5.3.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.8",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "testTimeout": 30000
  }
}
